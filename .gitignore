# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# real secrets
secrets/*
!secrets/.gitkeep

# root env files should not be used or committed
.env
.env.*
.dev.vars

# common secret files
*.pem
*.key
*.p12
service-account*.json
firebase-adminsdk*.json

# Flutter/Firebase 署名鍵・設定
*.jks
*.keystore
key.properties
google-services.json
GoogleService-Info.plist

# Terraform secrets(実値 tfvars・ローカル state)
*.tfvars
*.tfstate
*.tfstate.*
!*.tfvars.example

# ダミーの影(secrets.example/)は必ずコミットする。
# 上の .env / service-account*.json 等の広いパターンが secrets.example/ 配下のダミーまで
# 隠してしまい、clone 後にダミー差し替えマウントが空になる(隔離が壊れる)のを打ち消す。
!secrets.example/
!secrets.example/**
